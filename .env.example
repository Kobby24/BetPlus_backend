# BetPlus environment (frontend)

# Use FastAPI as the source of truth for users, wallet, bets, admin, and manager data.
NEXT_PUBLIC_USE_BACKEND=true

# FastAPI origin used by Next.js rewrites (server-side only).
BACKEND_URL=http://localhost:8000

# Admin portal cookie fallback (used when FastAPI is unreachable).
# Prefer signing in as a FastAPI user with is_admin=true.
ADMIN_EMAIL=admin@betplus.com
ADMIN_PASSWORD=admin123

# true = only /admin routes (npm run dev:admin). Leave unset for the public app.
# ADMIN_ONLY=false
