# BetPlus backend environment
# Copy to .env and adjust. Never commit real secrets.

# Development (SQLite file in backend/)
DATABASE_URL=sqlite:///./betplus.db

# Production / staging (PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/betplus

# JWT signing secret. Replace in every non-local environment.
SECRET_KEY=dev-insecure-key-set-SECRET_KEY-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Seed demo sports, matches, admin@betplus.com, and manager@betplus.local
SEED_DEMO_DATA=true

# development | test | production
ENVIRONMENT=development

# --- Testing ---
# Isolated SQLite is forced by tests/conftest.py.
# Optional PostgreSQL concurrency tests:
# POSTGRES_TEST_URL=postgresql://postgres:postgres@localhost:5432/betplus_test
